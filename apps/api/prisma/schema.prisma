// MTO Estimator — data model.
//
// Multi-company from day one: every business row carries companyId and the API filters every
// query by the signed-in member's company. A person belongs to one company at a time.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Organisation-wide roles. Everything else (site supervisor, finance, …) is an OrgRole below.
enum Role {
  owner // created the company; every permission, cannot be removed
  admin // every permission; manages the library, team, roles and projects
}

// A role a company defines (Settings › Roles & permissions): a name and the permissions it holds.
// Built-in ones are seeded per company; they can be renamed and re-permissioned but not deleted.
// People get them per project (ProjectMember.roles holds these keys).
model OrgRole {
  id          String   @id @default(cuid())
  companyId   String
  key         String // stable id used in ProjectMember.roles; the name can change, the key doesn't
  name        String
  description String   @default("")
  permissions String[]
  builtIn     Boolean  @default(false)
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
}

enum ProjectStatus {
  open
  closed
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  photo        String?
  provider     String          @default("email")
  createdAt    DateTime        @default(now())
  membership   Membership?
  sessions     Session[]
  projectRoles ProjectMember[]
}

// One row per signed-in device. The phone keeps a long-lived refresh token (only its hash is
// stored here) and swaps it for a short-lived access token. Deleting / revoking the row signs
// that device out at once — used for "Sign out of all devices" and lost phones.
model Session {
  id          String    @id @default(cuid())
  userId      String
  refreshHash String    @unique
  deviceName  String    @default("")
  platform    String    @default("")
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  expiresAt   DateTime // slides forward on every refresh (idle timeout)
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id        String   @id @default(cuid())
  name      String
  // Quotation letterhead: address, phone, email, gstin, termsAndConditions.
  profile   Json     @default("{}")
  createdAt DateTime @default(now())

  members        Membership[]
  invites        Invite[]
  estimates      Estimate[]
  stock          StockLine[]
  rates          RateOverride[]
  catalogs       CatalogVersion[]
  projects       Project[]
  orgRoles       OrgRole[]
  stockMovements StockMovement[]
}

model Membership {
  id        String   @id @default(cuid())
  companyId String
  userId    String   @unique
  // Organisation-level roles only: owner / admin (or none). Every other role is held per
  // project — see ProjectMember.
  roles     Role[]   @default([])
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// An admin adds a person's email; the first time that email signs in they join automatically.
model Invite {
  id          String   @id @default(cuid())
  companyId   String
  email       String
  name        String   @default("")
  roles       Role[]   @default([]) // organisation-level only (admin)
  // Project assignments applied when they first sign in: [{ projectId, roles: [...] }]
  projects    Json     @default("[]")
  invitedById String
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([email])
}

// A site or job the company is running. MTOs belong to one project each. Closing a project
// (once installation is done) returns any leftover site material to stock.
model Project {
  id                String             @id @default(cuid())
  companyId         String
  name              String
  // Short text typed once per project; every MTO in it is numbered <code>-MTO-0001, 0002, …
  code              String
  mtoSeq            Int                @default(0)
  siteName          String?
  notificationEmail String?
  status            ProjectStatus      @default(open)
  createdById       String
  closedById        String?
  closedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  estimates         Estimate[]
  consumptions      ConsumptionEntry[]
  members           ProjectMember[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, status])
}

// A person's roles on one project (site supervisor, project manager, finance, procurement,
// logistics, viewer — any mix). Owner and admin stay organisation-wide on Membership.
model ProjectMember {
  id        String   @id @default(cuid())
  companyId String
  projectId String
  userId    String
  roles     String[] // OrgRole.key values
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([companyId, userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("")
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  sentAt    DateTime @default(now())
}

// An MTO (material take-off / material request) — the model is still called Estimate for
// continuity with the original quotation feature it grew from. Stored as the same JSON
// document the app works with (`data`), plus a few columns pulled out for filtering.
model Estimate {
  companyId       String
  id              String // id generated by the app, unique inside the company
  estimateNumber  String // "MTO-0001" (was "EST-0001" before the Sept 2026 workflow change)
  name            String
  status          String         @default("DRAFT") // see MtoStatus values in src/lib/mtoStatus.ts
  projectId       String
  createdById     String
  data            Json
  clientUpdatedAt BigInt // the app's updatedAt (ms) — used for last-write-wins
  submittedAt     DateTime?
  closedAt        DateTime?
  updatedAt       DateTime       @updatedAt
  createdAt       DateTime       @default(now())
  deletedAt       DateTime?
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project         Project        @relation(fields: [projectId], references: [id])
  lines           EstimateLine[]
  events          MtoEvent[]
  dispatches      Dispatch[]

  @@id([companyId, id])
  @@index([companyId, createdById])
  @@index([companyId, projectId])
  @@index([companyId, status])
}

// Audit trail for every status move an MTO makes — who, when, from/to, and any comment
// (required by the API for Reject / Send back / Cancel). Shown as the History tab.
model MtoEvent {
  id         String   @id @default(cuid())
  companyId  String
  estimateId String
  actorId    String
  actorName  String   @default("")
  fromStatus String?
  toStatus   String?
  action     String // "transition" | "created" | ... (room for procurement/dispatch actions later)
  comment    String?
  createdAt  DateTime @default(now())
  estimate   Estimate @relation(fields: [companyId, estimateId], references: [companyId, id], onDelete: Cascade)

  @@index([companyId, estimateId, createdAt])
}

// One row per estimate line that draws on stock (i.e. not in a released status like Rejected).
model EstimateLine {
  companyId    String
  estimateId   String
  lineId       String
  stockKey     String
  qty          Decimal  @db.Decimal(14, 2)
  issuedQty    Decimal  @default(0) @db.Decimal(14, 2) // issued from store for this line (Phase 3)
  purchasedQty Decimal  @default(0) @db.Decimal(14, 2) // bought for this line (received into stock first)
  estimate     Estimate @relation(fields: [companyId, estimateId], references: [companyId, id], onDelete: Cascade)

  @@id([companyId, estimateId, lineId])
  @@index([companyId, stockKey])
}

// Stock is kept per project: each project has its own store, prices and ledger. projectId ""
// is the company's central stock — where a closed project's leftover material is returned.
model StockLine {
  companyId     String
  projectId     String   @default("") // "" only for legacy rows from before stock was project-scoped
  key           String // stockKey(): trade|item|material|size|secondarySize|core
  trade         String
  family        String   @default("")
  item          String
  material      String
  size          String
  secondarySize String?
  core          String?
  unit          String   @default("Nos")
  onHand        Decimal  @db.Decimal(14, 2)
  // Unit price (₹ per unit) the company pays / quotes for this exact line. 0 = not set.
  price         Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, projectId, key])
}

enum MovementType {
  RECEIPT // bought items received into store
  ISSUE // items issued from store for an MTO
  RETURN // leftover material returned to store (project close or cancel)
  ADJUST // manual correction by Procurement/Admin (reason required)
}

// Every stock in/out movement — the ledger that makes StockLine.onHand auditable.
model StockMovement {
  id              String       @id @default(cuid())
  companyId       String
  stockLineId     String // StockLine.key (compound PK: companyId + key)
  type            MovementType
  qty             Decimal      @db.Decimal(14, 2) // always positive; ISSUE/RETURN direction implied by type; ADJUST signed
  estimateId      String? // which MTO this movement is for
  projectId       String? // the store this movement is in ("" = central stock)
  sourceProjectId String? // for a project-close RETURN into central stock: the project it came back from
  reason          String? // required for ADJUST
  createdById     String
  createdAt       DateTime     @default(now())
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, stockLineId, createdAt])
  @@index([companyId, projectId, stockLineId, createdAt])
  @@index([companyId, sourceProjectId])
  @@index([companyId, estimateId])
}

// A dispatch record for an MTO (loading, transport, delivery). Phase 4 builds the full flow.
model Dispatch {
  id           String    @id @default(cuid())
  companyId    String
  estimateId   String
  loadingCheck Boolean   @default(false)
  loadingCost  Decimal   @default(0) @db.Decimal(14, 2)
  vehicle      String?
  driver       String?
  notes        String?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  createdById  String
  createdAt    DateTime  @default(now())
  estimate     Estimate  @relation(fields: [companyId, estimateId], references: [companyId, id], onDelete: Cascade)

  @@index([companyId, estimateId])
}

enum ConsumptionKind {
  USED // material installed or consumed in work
  WASTED // material scrapped or broken — not returned to stock on close
}

// Daily site use log, recorded by site_supervisor as materials are consumed.
// Site balance per stockKey = sum(issuedQty from DELIVERED/IN_USE/CLOSED MTOs) − USED − WASTED.
// Project close returns balance (not wasted) to stock.
model ConsumptionEntry {
  id          String          @id @default(cuid())
  companyId   String
  projectId   String
  stockKey    String // matches StockLine.key
  qty         Decimal         @db.Decimal(14, 2)
  kind        ConsumptionKind
  entryDate   DateTime // the calendar date (midnight UTC)
  note        String?
  createdById String
  createdAt   DateTime        @default(now())
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId, entryDate])
  @@index([companyId, projectId, stockKey])
}

// Project-specific rates. Anything not here falls back to the default rates in packages/shared.
model RateOverride {
  companyId    String
  projectId    String   @default("") // rates are per project; "" only for legacy rows
  key          String // rateKey(): trade::family::item::material
  materialRate Decimal  @db.Decimal(14, 2)
  labourRate   Decimal  @db.Decimal(14, 2)
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, projectId, key])
}

// Published versions of the item catalog (families, items, materials, sizes, cores).
// No row = the company uses the catalog bundled in packages/shared.
model CatalogVersion {
  companyId     String
  version       Int
  data          Json
  note          String   @default("")
  publishedById String
  publishedAt   DateTime @default(now())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, version])
}
