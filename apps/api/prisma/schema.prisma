// MTO Estimator — data model.
//
// Multi-company from day one: every business row carries companyId and the API filters every
// query by the signed-in member's company. A person belongs to one company at a time.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner     // created the company; full control, cannot be removed
  admin     // manages library (rates, stock), team, approves estimates
  estimator // field engineer: creates and edits their own estimates
  viewer    // read-only
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  name      String
  photo     String?
  provider  String      @default("email")
  createdAt DateTime    @default(now())
  membership Membership?
  sessions  Session[]
}

// One row per signed-in device. The phone keeps a long-lived refresh token (only its hash is
// stored here) and swaps it for a short-lived access token. Deleting / revoking the row signs
// that device out at once — used for "Sign out of all devices" and lost phones.
model Session {
  id           String    @id @default(cuid())
  userId       String
  refreshHash  String    @unique
  deviceName   String    @default("")
  platform     String    @default("")
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  expiresAt    DateTime  // slides forward on every refresh (idle timeout)
  revokedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  // Quotation letterhead: address, phone, email, gstin, termsAndConditions.
  profile     Json     @default("{}")
  // "block" = the API refuses an estimate save that would take more than is in stock.
  // "warn"  = it saves and the app shows the shortage in red.
  stockPolicy String   @default("block")
  estimateSeq Int      @default(0)
  createdAt   DateTime @default(now())

  members     Membership[]
  invites     Invite[]
  estimates   Estimate[]
  stock       StockLine[]
  rates       RateOverride[]
  catalogs    CatalogVersion[]
}

model Membership {
  id        String   @id @default(cuid())
  companyId String
  userId    String   @unique
  role      Role     @default(estimator)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// An admin adds a person's email; the first time that email signs in they join automatically.
model Invite {
  id          String   @id @default(cuid())
  companyId   String
  email       String
  name        String   @default("")
  role        Role     @default(estimator)
  invitedById String
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([email])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("")
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  sentAt    DateTime @default(now())
}

// An estimate is stored as the same JSON document the app works with (`data`), plus a few
// columns pulled out for filtering. Its lines are mirrored into EstimateLine so stock "used"
// can be summed in SQL.
model Estimate {
  companyId      String
  id             String   // id generated by the app, unique inside the company
  estimateNumber String
  name           String
  status         String   @default("Draft")
  createdById    String
  data           Json
  clientUpdatedAt BigInt  // the app's updatedAt (ms) — used for last-write-wins
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  deletedAt      DateTime?
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines          EstimateLine[]

  @@id([companyId, id])
  @@index([companyId, createdById])
}

// One row per estimate line that draws on stock (i.e. not in a released status like Rejected).
model EstimateLine {
  companyId  String
  estimateId String
  lineId     String
  stockKey   String
  qty        Decimal  @db.Decimal(14, 2)
  estimate   Estimate @relation(fields: [companyId, estimateId], references: [companyId, id], onDelete: Cascade)

  @@id([companyId, estimateId, lineId])
  @@index([companyId, stockKey])
}

model StockLine {
  companyId     String
  key           String   // stockKey(): trade|item|material|size|secondarySize|core
  trade         String
  family        String   @default("")
  item          String
  material      String
  size          String
  secondarySize String?
  core          String?
  unit          String   @default("Nos")
  onHand        Decimal  @db.Decimal(14, 2)
  // Unit price (₹ per unit) the company pays / quotes for this exact line. 0 = not set.
  price         Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, key])
}

// Company-specific rates. Anything not here falls back to the default rates in packages/shared.
model RateOverride {
  companyId    String
  key          String   // rateKey(): trade::family::item::material
  materialRate Decimal  @db.Decimal(14, 2)
  labourRate   Decimal  @db.Decimal(14, 2)
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, key])
}

// Published versions of the item catalog (families, items, materials, sizes, cores).
// No row = the company uses the catalog bundled in packages/shared.
model CatalogVersion {
  companyId     String
  version       Int
  data          Json
  note          String   @default("")
  publishedById String
  publishedAt   DateTime @default(now())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, version])
}
