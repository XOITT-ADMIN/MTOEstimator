# Postgres connection string (Neon / Supabase / Aiven / local). Neon needs ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mto

# Long random string used to sign login tokens. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000
# Comma-separated origins allowed to call the API from a browser (Expo web). * = any.
CORS_ORIGINS=*

# Email for sign-in codes. Leave SMTP_URL empty to run in DEMO mode: the code is returned by
# the API and shown on the login screen (never use demo mode in production).
# Gmail example: smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM="XMTO <no-reply@example.com>"
OTP_DEMO=true

# Sign-in lifetime. Access tokens are short-lived and renewed automatically; a phone that isn't
# used for REFRESH_IDLE_DAYS must sign in with an email code again.
ACCESS_TOKEN_TTL=1h
REFRESH_IDLE_DAYS=60
AUTH_RATE_LIMIT=10
